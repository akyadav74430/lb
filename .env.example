# ==================================================
# Lovebite.com — Environment Variables Template
# ==================================================

# Database Connection URL:
# Supabase Postgres example:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Optional: keep these only if you want to mirror some local runtime metadata
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NextAuth / Auth.js Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-random-secret-key-at-least-32-chars"
AUTH_SECRET="your-random-secret-key-at-least-32-chars"
NEXTAUTH_URL="https://lovebite01.vercel.app"
NEXT_PUBLIC_APP_URL="https://lovebite01.vercel.app"

# Application Settings
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
UPLOADS_DIR="/app/uploads"

# Support Email Delivery Configuration (Nodemailer SMTP)
SUPPORT_EMAIL="support@lovebite.com"
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USERNAME="your-smtp-username"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM="lovebite.com Support <support@lovebite.com>"

# Google reCAPTCHA v2 (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
