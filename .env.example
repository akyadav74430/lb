# ==================================================
# Lovebite.com — Environment Variables Template
# ==================================================

# Database Connection URL:
# For Docker Compose: "mysql://lovebite:password@database:3306/lovebite"
# For Local MySQL:    "mysql://lovebite:password@localhost:3306/lovebite"
# For Local SQLite:   "file:./data/app.db" (requires provider = "sqlite" in schema.prisma)
DATABASE_URL="mysql://lovebite:lovebite_secure_pass_2026@database:3306/lovebite"

# MySQL Credentials (used by Docker Compose)
MYSQL_DATABASE="lovebite"
MYSQL_USER="lovebite"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_ROOT_PASSWORD="your-mysql-root-password"

# NextAuth / Auth.js Secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-random-secret-key-at-least-32-chars"
AUTH_SECRET="your-random-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Settings
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
UPLOADS_DIR="/app/uploads"

# Support Email Delivery Configuration (Nodemailer SMTP)
SUPPORT_EMAIL="support@lovebite.com"
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USERNAME="your-smtp-username"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM="lovebite.com Support <support@lovebite.com>"

# Google reCAPTCHA v2 (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
