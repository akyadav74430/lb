+      const compositeSlug = `${citySlug_}|${localitySlug_}`;
+      const existing = bySlug.get(compositeSlug);
+      if (existing) {
+        existing.count += 1;
+        if (!existing.storedLocalAreas.includes(profile.localArea)) {
+          existing.storedLocalAreas.push(profile.localArea);
+        }
+        continue;
+      }
